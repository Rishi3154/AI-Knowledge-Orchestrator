# Copy this file to .env and adjust. .env is ignored by git.

# true  = run everything locally with Ollama (llama3.2 + nomic-embed-text)
# false = use OpenAI (gpt-4o-mini + text-embedding-3-small)
USE_LOCAL_MODELS=true

# Only needed when USE_LOCAL_MODELS=false.
OPENAI_API_KEY=

# Optional. Adds Claude to the model picker for answering questions.
# Embeddings still follow USE_LOCAL_MODELS (Anthropic has none).
ANTHROPIC_API_KEY=
